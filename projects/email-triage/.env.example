# =============================================================================
# email-triage environment variables
# Copy this file to .env and fill in your values. Never commit .env.
# =============================================================================

# === RELAY PROCESS ===

RELAY__GMAIL_ENABLED=true
RELAY__GMAIL_USERNAME=you@gmail.com
RELAY__GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
RELAY__GMAIL_MAILBOX=INBOX
# RELAY__GMAIL_HOST=imap.gmail.com       # default
# RELAY__GMAIL_PORT=993                  # default

RELAY__PROTON_ENABLED=false
RELAY__PROTON_USERNAME=you@proton.me
RELAY__PROTON_PASSWORD=bridge-generated-password
RELAY__PROTON_HOST=127.0.0.1
RELAY__PROTON_PORT=1143
RELAY__PROTON_MAILBOX=INBOX

RELAY__POLL_INTERVAL_SECONDS=60
RELAY__QUEUE_DIR=/run/email-triage/queue
RELAY__STATE_DIR=/var/lib/email-triage/relay
RELAY__GPG_HOME=/var/lib/email-triage/relay/.gnupg
RELAY__GPG_RECIPIENT_FINGERPRINT=ABCDEF1234567890ABCDEF1234567890ABCDEF12
RELAY__MAX_EMAIL_SIZE_BYTES=10000000

# === AGENT PROCESS ===

ANTHROPIC_API_KEY=sk-ant-...
AGENT__CLAUDE_MODEL=claude-opus-4-6
AGENT__CLAUDE_MAX_TOKENS=1024
AGENT__CLAUDE_TEMPERATURE=0.0
AGENT__MAX_CONCURRENT_EMAILS=3

AGENT__QUEUE_DIR=/run/email-triage/queue
AGENT__STATE_DIR=/var/lib/email-triage/agent
AGENT__GPG_HOME=/var/lib/email-triage/agent/.gnupg
AGENT__GPG_PRIVATE_KEY_PASSPHRASE_FILE=/etc/email-triage/agent-key.passphrase
AGENT__DONE_DIR=/var/lib/email-triage/done
AGENT__FAILED_DIR=/var/lib/email-triage/failed
AGENT__PROCESSING_TIMEOUT_SECONDS=120

# Optional webhook for CRITICAL / HIGH priority alerts
AGENT__WEBHOOK_URL=
AGENT__WEBHOOK_SECRET=

# === SHARED ===

LOG_LEVEL=INFO
LOG_FORMAT=json
ENV=production

VAULT_PATH=/home/grant/vault
# Run the container as this user so it can write to the vault directory.
# Get your uid/gid with: id -u && id -g
DOCKER_UID=1000
DOCKER_GID=1000
MCP_API_KEY=your-secret-api-key-here
PORT=3000
NODE_ENV=production
# Public URL prefix when deployed at a sub-path (e.g. vermillion.world/mcp).
# Leave empty if deployed as a subdomain (e.g. mcp.vermillion.pro).
BASE_PATH=/mcp

# Telegram
TELEGRAM_BOT_TOKEN=          # from @BotFather
OWNER_CHAT_ID=               # your numeric Telegram user ID (get from @userinfobot)

# Anthropic
ANTHROPIC_API_KEY=           # sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-6

# 2FA — generate secret with: python -c "import pyotp; print(pyotp.random_base32())"
# Then add to your authenticator app (Proton Pass, etc.) as a TOTP entry
TOTP_SECRET=                 # base32 string, e.g. JBSWY3DPEHPK3PXP
TOTP_GRACE_MINUTES=20        # skip TOTP challenge if verified within this window

# Gmail MCP credentials base path — each account has a subdirectory here
# Structure: ~/.gmail-mcp/{phdata,pgmc,multdems,personal}/credentials.json
GMAIL_MCP_CREDENTIALS_BASE=~/.gmail-mcp

# Logging
LOG_LEVEL=INFO

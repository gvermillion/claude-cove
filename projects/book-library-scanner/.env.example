# Optional: Google Books API key for richer metadata and cover images
# Without this, only Open Library is used (still excellent coverage)
# Get a key at: https://console.cloud.google.com/apis/library/books.googleapis.com
VITE_GOOGLE_BOOKS_API_KEY=

# Optional: Langfuse observability (leave blank to disable)
VITE_LANGFUSE_PUBLIC_KEY=
VITE_LANGFUSE_HOST=https://cloud.langfuse.com
